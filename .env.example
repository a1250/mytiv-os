# Neon Postgres — pooled connection string (used at runtime by lib/db/index.ts)
DATABASE_URL=

# Neon Postgres — direct/unpooled connection string (used only by drizzle-kit for migrations)
DATABASE_URL_UNPOOLED=

# Auth.js
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Master key for per-business secret encryption (Claude key, Google tokens, Higgsfield key).
# Generate with: openssl rand -hex 32
SECRETS_MASTER_KEY=

# Google OAuth (Web application client — separate from the Electron app's desktop client)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/google/oauth/callback

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Upstash QStash (Phase 4 — Discover Leads / Contact Finder async jobs)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Vercel Cron auth (Phase 4 — radar poll / gmail sync / calendar sync)
CRON_SECRET=

# ClickUp — source of truth for delivery tasks (Ops module).
# Personal API token from ClickUp → Settings → Apps → API Token.
# Server-side only: never expose as NEXT_PUBLIC_*.
CLICKUP_API_TOKEN=
CLICKUP_WORKSPACE_ID=90182347023

# Days without a ClickUp update before a task is considered stuck (default 3)
STUCK_THRESHOLD_DAYS=3

# Contractor cost per hour, for the Phase 4 margin view
CONTRACTOR_HOURLY_COST=

# Seed script — creates the first user + Mytiv business (Phase 0 only, run once)
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# Marketing artifacts / decisions / evidence routes (T-3.2). Off unless exactly "true"; off = the routes answer 404.
MARKETING_MODULE_ENABLED=false
